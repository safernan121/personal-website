{
  "name": "personal-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "cv": "\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless=new --disable-gpu --no-pdf-header-footer --print-to-pdf=public/santiago-fernandez-cv.pdf \"file://$PWD/resume/santiago-fernandez-cv.html\"",
    "previews": "node scripts/preview-images.mjs",
    "deploy": "npm run lint && npm run typecheck && npm run build && wrangler deploy",
    "preview:cloudflare": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "description": "The personal portfolio of Santiago Fernández, Software Engineer.",
  "engines": {
    "node": ">=22.12.0"
  }
